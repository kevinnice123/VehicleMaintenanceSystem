<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VehicleMaintenanceSystem</RootNamespace>
    <AssemblyName>VehicleMaintenanceSystem</AssemblyName>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="Views\LoginForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Views\MainForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Views\RegisterForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Views\DashboardView.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Views\VehiclesView.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Views\DriversView.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Views\MaintenanceView.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Views\HistoryView.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Views\ReportsView.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Views\UsersView.cs">
      <SubType>UserControl</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="8.0.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Database\schema.sql" LogicalName="schema.sql" />
  </ItemGroup>

</Project>
